# Copy this file to .env and fill in real values. Never commit .env itself.

FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret

# --- MySQL ---
# Leave MYSQL_PASSWORD blank to fall back to a local SQLite file
# (dev.db) so the app runs out-of-the-box before MySQL is set up.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ai_news_chatbot

# --- News APIs (added in Phase 4) ---
NEWSAPI_KEY=
GNEWS_API_KEY=
GUARDIAN_API_KEY=
NYTIMES_API_KEY=
MEDIASTACK_API_KEY=

# --- AI Chatbot (added in Phase 5) ---
GEMINI_API_KEY=

# --- Newsletter email (added in Phase 6) ---
MAIL_USERNAME=
MAIL_PASSWORD=
